# Copier ce fichier en .env (jamais commité) : cp .env.example .env
# Valeurs de développement local uniquement (docker-compose.yml). En production, les vraies
# valeurs sont des variables de l'hébergeur.

# Connexion de l'application : rôle restreint, soumis à la Row Level Security.
# Le mot de passe est aussi utilisé par « pnpm db:setup » pour créer ce rôle.
DATABASE_URL=postgres://pomme_app:pomme_app_dev@localhost:5432/pomme

# Connexion du propriétaire : migrations et jeu de données fictif seulement.
DATABASE_MIGRATION_URL=postgres://pomme:pomme_dev@localhost:5432/pomme

# Connexion de Better Auth (comptes, sessions, passkeys) : rôle dédié, seul autorisé à lire
# les sessions et jetons de connexion. Créé lui aussi par « pnpm db:setup ».
DATABASE_AUTH_URL=postgres://pomme_auth:pomme_auth_dev@localhost:5432/pomme

# Adresse publique de l'application (liens magiques, passkeys).
BETTER_AUTH_URL=http://localhost:3000
# Clé de signature des cookies : 32 caractères au moins. En production, une valeur aléatoire
# (openssl rand -base64 32) fournie par l'hébergeur.
BETTER_AUTH_SECRET=developpement-seulement-ne-pas-utiliser-en-production

# Envoi des emails. En local : Mailpit (docker-compose.yml), lecture sur http://localhost:8025.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Pomme <ne-pas-repondre@example.org>"
