{
  "name": "pomme",
  "version": "0.1.0",
  "private": true,
  "description": "Application de création et de gestion d'AMAP",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "prepare": "husky",
    "test": "vitest run --project unit --project components",
    "test:watch": "vitest --project unit --project components",
    "test:coverage": "vitest run --project unit --project components --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --project=chromium --project=webkit-mobile",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "db:up": "docker compose up -d --wait postgres mailpit",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx --env-file-if-exists=.env src/db/scripts/setup.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/scripts/seed.ts",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:setup && pnpm db:migrate && pnpm db:seed",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.0",
    "@date-fns/tz": "^1.2.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@friendlycaptcha/sdk": "1.1.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "better-auth": "^1.7.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.0",
    "next-intl": "^4.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@playwright/test": "^1.56.0",
    "@testcontainers/postgresql": "^11.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-security": "^3.0.0",
    "husky": "^9.1.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
